# Local Railway Postgres (testing). Do not commit real secrets.
# Generate with: npm run db:railway-env
#
# Dashboard: https://railway.com/project/428e87b0-92c3-4688-9320-0c95a04e9372

DATABASE_SSL=0
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Background worker. Unset: runs inline when DATABASE_URL is empty (PGlite).
# off = web only; run `npm run worker` separately. inline = always in-process.
# CONSOL_WORKER=off
# WORKER_CONCURRENCY=4

# Optional local demo auth without Cursor identity
# CONSOL_DEMO_AUTH=1

# Optional GitHub OAuth App (Connectors → GitHub). Not needed when gh/GITHUB_TOKEN is set.
# Create at https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: http://127.0.0.1:43123/api/connectors/github/oauth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional override for the callback URL:
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:43123/api/connectors/github/oauth/callback
# Encrypts stored OAuth tokens (falls back to GITHUB_CLIENT_SECRET):
# CONNECTOR_TOKEN_SECRET=
# Force dry-run PR opens even when OAuth is connected:
# CONSOL_GITHUB_DRY_RUN=1

# Models — interchangeable via CONSOL_MODEL ("<provider>:<model>").
# Default: ANTHROPIC_API_KEY, else the local `claude` CLI login (claude-cli).
# When the primary hits a rate limit / capacity error, Consol tries the next
# configured provider (and CONSOL_MODEL_FALLBACKS, if set).
# ANTHROPIC_API_KEY=
# CONSOL_MODEL=anthropic:claude-opus-5-5
# CONSOL_MODEL_FALLBACKS=openai:gpt-4o-mini,gateway:openai/gpt-4o-mini
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=

# Software delivery repo. Default: this checkout's `git remote get-url origin`.
# CONSOL_GITHUB_REPO=owner/repo
# CONSOL_GITHUB_BASE_BRANCH=main
# GitHub token for PRs/checks/merge. Default: `gh auth token`.
# GITHUB_TOKEN=

# Build-stage coding agent: cursor (Cloud Agents) or claude-code (local CLI).
# Default: cursor if CURSOR_API_KEY is set, else claude-code if `claude` is installed.
# CONSOL_CODING_AGENT=claude-code
# CURSOR_API_KEY=
# Force dry-run Cursor builds even when a key is set:
# CONSOL_CURSOR_DRY_RUN=1
