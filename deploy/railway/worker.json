{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/lib/**", "src/worker.ts", "migrations/**", "package*.json", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "npm run worker",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 60
  }
}
